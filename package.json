{
  "name": "@lleverage-ai/agent-sdk-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@lleverage-ai/agent-sdk' build",
    "test": "bun run --filter '@lleverage-ai/agent-sdk' build && bun run --filter '@lleverage-ai/agent-sdk' test",
    "type-check": "bun run --filter '@lleverage-ai/agent-sdk' type-check",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "bun run --filter '@lleverage-ai/agent-sdk' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tsconfig/node22": "^22.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.2"
  }
}
